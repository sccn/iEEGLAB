**/fsaverage

# Anything created inside the flat tutorial folders (import or analysis output),
# except the walkthrough screenshots (without the capture log: it holds local paths)
tutorial/*/*/
!tutorial/images/walkthrough/
tutorial/images/walkthrough/capture_log.txt

